{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1080px",
      "wideSize": "1200px"
    },
    "color": {
      "palette": [
        { "slug": "black", "name": "Black", "color": "#060606" },
        { "slug": "gold", "name": "Gold", "color": "#d4af37" },
        { "slug": "gold-light", "name": "Gold Light", "color": "#f5d77a" },
        { "slug": "text", "name": "Text", "color": "#f5efe1" },
        { "slug": "muted", "name": "Muted", "color": "#c7b38a" }
      ]
    },
    "typography": {
      "fluid": true
    },
    "spacing": {
      "units": ["px", "rem", "%", "vh", "vw"]
    }
  },
  "styles": {
    "color": {
      "background": "#060606",
      "text": "#f5efe1"
    },
    "elements": {
      "link": {
        "color": {
          "text": "#f5d77a"
        },
        "typography": {
          "textDecoration": "none"
        }
      }
    },
    "typography": {
      "fontFamily": "\"Rajdhani\", system-ui, sans-serif"
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ]
}
