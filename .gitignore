# ===============================
# Sistema operativo / editor
# ===============================
.DS_Store
Thumbs.db
.vscode/
.idea/

# ===============================
# Entornos y credenciales
# ===============================
.env
*.env

# ===============================
# WordPress core generado por Docker
# ===============================
wordpress/*
!wordpress/wp-content/

wordpress/wp-content/*
!wordpress/wp-content/themes/
!wordpress/wp-content/plugins/

# Ignorar todos los temas excepto el tema propio del Producto 4
wordpress/wp-content/themes/*
!wordpress/wp-content/themes/reparaya-producto-4/
!wordpress/wp-content/themes/reparaya-producto-4/**

# Ignorar plugins de terceros instalados desde WordPress
wordpress/wp-content/plugins/*

# Archivos sensibles o generados por WordPress
wordpress/wp-config.php
wordpress/wp-content/uploads/
wordpress/wp-content/cache/
wordpress/wp-content/upgrade/
wordpress/wp-content/backups/
wordpress/wp-content/ai1wm-backups/
wordpress/wp-content/debug.log

# ===============================
# Dependencias / temporales
# ===============================
node_modules/
vendor/
*.log
*.tmp

# ===============================
# Laravel Producto 3 como referencia local
# ===============================
laravel/vendor/
laravel/node_modules/
laravel/storage/logs/*
laravel/storage/framework/cache/data/*
laravel/storage/framework/sessions/*
laravel/storage/framework/views/*

# ===============================
# Entrega final
# ===============================
*.zip
*.rar
*.sql.gz
